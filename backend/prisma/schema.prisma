generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int           @id @default(autoincrement())
  name              String
  email             String        @unique
  passwordHash      String
  preferredLanguage String        @default("en")
  profileImage      String        @default("")
  createdAt         DateTime      @default(now())
  chatMessages      ChatMessage[]
  expenses          Expense[]
  journals          Journal[]
  reviews           Review[]
  trips             Trip[]

  @@map("users")
}

model Attraction {
  id                 Int       @id @default(autoincrement())
  nameEn             String
  nameAr             String?
  city               String
  descriptionEn      String?
  descriptionAr      String?
  entryFee           Float?
  openingHours       String?
  rating             Float?
  latitude           Float?
  longitude          Float?
  categoryId         Int?
  types              String[]
  description        String?
  opening_hours      Json?
  place_id           String?
  name               String?
  address            String?
  lat                Float?
  lng                Float?
  user_ratings_total Int?
  category           String?
  photoUrl           String?   @map("photo_url")
  created_at         DateTime? @default(now()) @db.Timestamp(6)

  @@index([city])
  @@index([categoryId])
  @@index([city], map: "idx_attractions_city")
  @@map("attractions")
}

model Hotel {
  id            Int       @id @default(autoincrement())
  nameEn        String
  nameAr        String?
  city          String
  descriptionEn String?
  descriptionAr String?
  stars         Int?
  pricePerNight Float?
  rating        Float?
  latitude      Float?
  longitude     Float?
  externalId    String?   @unique @map("external_id")
  country       String?
  amenities     Json?
  updatedAt     DateTime? @map("updated_at")
  imageUrl      String?

  @@index([city])
  @@index([stars])
  @@map("hotels")
}

model Restaurant {
  id            Int     @id @default(autoincrement())
  nameEn        String
  nameAr        String?
  city          String
  cuisine       String?
  priceRange    String?
  descriptionEn String?
  descriptionAr String?
  phone         String?
  rating        Float?
  photo_url     String?

  @@index([city])
  @@index([cuisine])
  @@map("restaurants")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
  type String

  @@index([type])
  @@map("categories")
}

model Trip {
  id          Int       @id @default(autoincrement())
  userId      Int
  name        String
  destination String
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  notes       String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trips")
}

model Expense {
  id          Int       @id @default(autoincrement())
  userId      Int
  tripId      Int
  description String
  amount      Float
  category    String?
  date        DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@map("expenses")
}

model Journal {
  id        Int       @id @default(autoincrement())
  userId    Int
  tripId    Int
  title     String
  content   String
  date      DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@map("journals")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  placeType String
  placeId   Int
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([placeType, placeId])
  @@map("reviews")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  response  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_messages")
}

model photos {
  id       BigInt  @id @default(autoincrement())
  url      String  @unique(map: "photos_url_unique_idx")
  location String?
  category String?
  source   String
}
